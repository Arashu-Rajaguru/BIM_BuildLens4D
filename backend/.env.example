# ==============================================================================
# BuildLens 4D - Backend Environment Configuration (.env.example)
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# API Configuration
PROJECT_NAME="BuildLens 4D API"
API_V1_STR="/api"
VERSION="1.0.0"
ENVIRONMENT="development"

# Database Configuration
# Default development mode: zero-configuration SQLite database
DATABASE_URL="sqlite:///./buildlens4d.db"

# Production / PostgreSQL Staging mode (uncomment to use PostgreSQL):
# DATABASE_URL="postgresql://buildlens_user:securepassword@localhost:5432/buildlens4d"

# CORS Origins (comma-separated URLs allowed to communicate with this backend)
# Port 5173 is the Vite dashboard, Port 3000 is alternative frontend
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Mobile AR / Unity LAN Testing Note:
# An Android physical phone running the Unity AR app cannot reach "localhost" on your PC.
# When testing on Android via Wi-Fi, add your PC's LAN IP to ALLOWED_ORIGINS, e.g.:
# ALLOWED_ORIGINS="http://localhost:5173,http://192.168.1.100:8000"
